# =============================================================================
# Parents Health OS — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# GEMINI AI (Server-side key required for lab report analysis)
# Get from: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# SUPABASE — Parents Health OS Dedicated Project
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-parents-health-os-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_parents_health_os_publishable_key_here
SUPABASE_SECRET_KEY=your_parents_health_os_secret_key_here

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS API
# Get from: https://developers.facebook.com/apps/
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_DRY_RUN=true
